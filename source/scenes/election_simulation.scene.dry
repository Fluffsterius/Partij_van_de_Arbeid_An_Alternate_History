title: Election Simulation
set-jump: post_election


- @1928: 1928 historical scenario
- @1930: 1930 historical scenario
- @1932: 1932 (July) historical scenario

@1928
on-arrival: {!
Q.workers = 46; // industry and trade
Q.old_middle = 13; // "old mittelstand"
// 16.4 trade & commerce, 6.6 public and private services, 4.4 domestic help
Q.new_middle = 14; // "new mittelstand"
Q.rural = 25; // agriculture and forestry employment... but many of those are proletarians so...
// source: https://surface.syr.edu/cgi/viewcontent.cgi?filename=3&article=1016&context=books&type=additional page 43, table 3.3
Q.unemployed = 8.6;
Q.catholics = 30;

Q.classes = ['workers', 'old_middle', 'new_middle', 'rural', 'unemployed', 'catholics'];
Q.parties = ['pvda', 'sp', 'cda', 'd66', 'vvd', 'pvv', 'gl', 'other'];

// Support for party by social group
// they don't have to sum to 100 since the electoral calculations will be normalicdaed.
Q.workers_pvda = 30;
Q.workers_sp = 50;
Q.workers_cda = 9
Q.workers_d66 = 2;
Q.workers_vvd = 0;
Q.workers_pvv = 10;
Q.workers_gl = 5;
Q.workers_other = 5;

Q.old_middle_pvda = 15;
Q.old_middle_sp = 0;
Q.old_middle_cda = 25;
Q.old_middle_d66= 10;
Q.old_middle_vvd = 40;
Q.old_middle_pvv = 10;
Q.old_middle_gl = 2;
Q.old_middle_other = 10;

Q.new_middle_pvda = 25;
Q.new_middle_sp = 9;
Q.new_middle_cda = 15;
Q.new_middle_d66= 10;
Q.new_middle_vvd = 25;
Q.new_middle_pvv = 8;
Q.new_middle_gl = 7;
Q.new_middle_other = 5;

Q.rural_pvda = 5;
Q.rural_sp = 2;
Q.rural_cda = 35;
Q.rural_d66= 2;
Q.rural_vvd = 20;
Q.rural_pvv = 15;
Q.rural_gl = 0;
Q.rural_other = 10;

Q.unemployed_pvda = 45;
Q.unemployed_sp = 40;
Q.unemployed_cda = 9;
Q.unemployed_d66 = 3;
Q.unemployed_vvd = 1;
Q.unemployed_pvv = 20;
Q.unemployed_gl = 5;
Q.unemployed_other = 9;

Q.catholics_pvda = 15;
Q.catholics_sp = 5;
Q.catholics_cda = 50;
Q.catholics_d66 = 0;
Q.catholics_vvd = 5;
Q.catholics_pvv = 5;
Q.catholics_gl = 0;
Q.catholics_other = 10;
!}
go-to: election_algorithm
set-jump: post_election

